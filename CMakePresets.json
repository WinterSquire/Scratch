{
    "version": 3,
    "configurePresets": [
        {
            "name": "MSVC",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "MSVCDebug",
            "inherits": "MSVC",
            "binaryDir": "Build/MSVCDebug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug"
            }
        },
        {
            "name": "MSVCRelease",
            "inherits": "MSVC",
            "binaryDir": "Build/MSVCRelease",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release"
            }
        }
    ]
}